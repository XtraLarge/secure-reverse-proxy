SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Reverse-Proxy Statusprüfer — jede Minute.
# Schreibt /run/apache-proxy/status.tab (von toc.lua nur gelesen).
